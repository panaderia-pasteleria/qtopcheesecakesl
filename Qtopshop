      try {
        const raw = localStorage.getItem('qtopcheesecake_cart');
        const arr = raw ? JSON.parse(raw) : [];
        return Array.isArray(arr) ? arr : [];
      } catch {
        return [];
      }
    }

    function renderOrderSummary(items) {
      const box = document.getElementById('orderItems');
      const total = (typeof calculateTotal === 'function') ? calculateTotal() : items.reduce((s,i)=>s+(i.price*i.quantity),0);

      box.innerHTML = items.map(i => `
        <div class="order-item">
          <div>
            <strong>${i.name}</strong>
            <div class="muted">${i.quantity} × ${formatPrice(i.price)}</div>
          </div>
          <div style="font-weight:600; color: var(--color-primary);">
            ${formatPrice((parseFloat(i.price)||0) * (parseInt(i.quantity)||0))}
          </div>
        </div>
      `).join('');

      document.getElementById('summaryTotal').textContent = formatPrice(total);
      return total;
    }

    document.addEventListener('DOMContentLoaded', () => {
      const items = getCartSafe();

      if (!items.length) {
        alert('Tu carrito está vacío');
        location.href = 'productos.html';
        return;
      }

      const total = renderOrderSummary(items);

      // FIX CRÍTICO: si total queda 0 => no permitir PayPal
      if (!total || isNaN(total) || total <= 0) {
        alert('Error: total inválido. Revisa el carrito.');
        location.href = 'carrito.html';
        return;
      }

      paypal.Buttons({
        createOrder: function(data, actions) {
          const form = document.getElementById('checkoutForm');
          if (!form.checkValidity()) {
            form.reportValidity();
            return;
          }

          const safeItems = getCartSafe();

          const amountValue = (typeof calculateTotal === 'function')
            ? calculateTotal().toFixed(2)
            : safeItems.reduce((s,i)=>s+(i.price*i.quantity),0).toFixed(2);

          return actions.order.create({
            purchase_units: [{
              description: 'Pedido Qtopcheesecake',
              amount: {
                currency_code: 'EUR',
                value: amountValue,
                breakdown: {
                  item_total: { currency_code: 'EUR', value: amountValue }
                }
              },
              items: safeItems.map(i => ({
                name: i.name,
                unit_amount: { currency_code: 'EUR', value: (parseFloat(i.price)||0).toFixed(2) },
                quantity: String(parseInt(i.quantity)||1)
              }))
            }]
          });
        },

        onApprove: function(data, actions) {
          return actions.order.capture().then(function(details) {
            // Limpia carrito
